# Copy to .env.local for `vercel dev` — never commit secrets.
# Production: optional overrides in Vercel → Environment Variables.

# Optional — overrides default inbox (see api/contact.js)
# CONTACT_TO_EMAIL=

# Optional — if set, mail is sent via Resend instead of FormSubmit
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Portfolio <hello@yourdomain.com>
