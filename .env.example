# Copy to .env.local for `vercel dev` — never commit secrets.
# Set at least ONE delivery method in Vercel → Environment Variables.

# Recommended (free): https://web3forms.com — inbox is your signup email
# WEB3FORMS_ACCESS_KEY=

# Or use Resend: https://resend.com
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=you@gmail.com
# RESEND_FROM_EMAIL=Portfolio <hello@yourdomain.com>
